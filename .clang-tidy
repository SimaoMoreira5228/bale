Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include/bale|src|apps|tests|tools)/'
FormatStyle: file
