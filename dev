#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
build_root="$repo_root/build"
build_dir="${BUILD_DIR:-$build_root/dev}"
jobs="${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)}"

if [[ ! "$jobs" =~ ^[1-9][0-9]*$ ]]; then
    echo "JOBS must be a positive integer" >&2
    exit 2
fi

configure() {
    local dir="$1"
    shift

    local generator_args=()
    if [[ ! -f "$dir/CMakeCache.txt" ]] && command -v ninja >/dev/null; then
        generator_args=(-G Ninja)
    fi

    cmake -S "$repo_root" -B "$dir" "${generator_args[@]}" \
        --no-warn-unused-cli \
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
        -DBALE_WERROR=ON \
        "$@"
}

build() {
    local dir="$1"
    shift

    cmake --build "$dir" --parallel "$jobs" "$@"
}

run_tests() {
    local dir="$1"
    shift

    ctest --test-dir "$dir" --output-on-failure --parallel "$jobs" "$@"
}

lint() {
    command -v clang-tidy >/dev/null || {
        echo "clang-tidy is required for lint" >&2
        exit 1
    }
    command -v python3 >/dev/null || {
        echo "Python 3 is required to read CMake's compile database" >&2
        exit 1
    }

    configure "$build_dir"
    build "$build_dir"

    python3 - "$build_dir/compile_commands.json" "$repo_root" <<'PY' \
        | xargs -0 -r -n 1 -P "$jobs" clang-tidy --quiet -p "$build_dir"
import json
import os
import sys

database_path, repo_root = sys.argv[1], os.path.abspath(sys.argv[2])
excluded = (
    os.path.join(repo_root, "build") + os.sep,
    os.path.join(repo_root, "third_party") + os.sep,
)

with open(database_path, encoding="utf-8") as database:
    commands = json.load(database)

seen = set()
for command in commands:
    source = os.path.abspath(os.path.join(command["directory"], command["file"]))
    if source in seen or source.startswith(excluded):
        continue
    if not source.startswith(repo_root + os.sep):
        continue
    if source.endswith((".c", ".cc", ".cpp", ".cxx")):
        seen.add(source)
        sys.stdout.buffer.write(os.fsencode(source) + b"\0")
PY
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    setup)
        echo "Build: CMake 3.25+, GCC 14+ or Clang 18+ with C++23, Ninja (Make works too)."
        echo "Format and lint: clang-format, clang-tidy, Python 3."
        echo "Coverage report: gcovr (optional)."
        echo "Windows cross-check: MinGW-w64 GCC and Wine (optional)."
        ;;
    configure)
        configure "$build_dir" "$@"
        ;;
    build)
        configure "$build_dir"
        build "$build_dir" "$@"
        ;;
    test)
        configure "$build_dir"
        build "$build_dir"
        run_tests "$build_dir" "$@"
        ;;
    sanitize)
        sanitize_dir="$build_root/sanitize"
        sanitize_flags="-fsanitize=address,undefined -fno-sanitize-recover=undefined"
        sanitize_flags+=" -fno-omit-frame-pointer"
        configure "$sanitize_dir" \
            -DBALE_LINK_COMPILE_COMMANDS=OFF \
            -DCMAKE_BUILD_TYPE=Debug \
            -DCMAKE_C_FLAGS="$sanitize_flags" \
            -DCMAKE_CXX_FLAGS="$sanitize_flags" \
            -DCMAKE_EXE_LINKER_FLAGS="-fsanitize=address,undefined" \
            -DCMAKE_SHARED_LINKER_FLAGS="-fsanitize=address,undefined"
        build "$sanitize_dir"
        ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=1:strict_string_checks=1}" \
            UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1}" \
            run_tests "$sanitize_dir" "$@"
        ;;
    tsan)
        tsan_dir="$build_root/tsan"
        tsan_flags="-fsanitize=thread -fno-omit-frame-pointer"
        # WORKAROUND: Fedora's GCC ships no libtsan, so ThreadSanitizer builds use Clang.
        configure "$tsan_dir" \
            -DCMAKE_C_COMPILER="${TSAN_CC:-clang}" \
            -DCMAKE_CXX_COMPILER="${TSAN_CXX:-clang++}" \
            -DBALE_LINK_COMPILE_COMMANDS=OFF \
            -DCMAKE_BUILD_TYPE=Debug \
            -DCMAKE_C_FLAGS="$tsan_flags" \
            -DCMAKE_CXX_FLAGS="$tsan_flags" \
            -DCMAKE_EXE_LINKER_FLAGS="-fsanitize=thread" \
            -DCMAKE_SHARED_LINKER_FLAGS="-fsanitize=thread"
        build "$tsan_dir"
        TSAN_OPTIONS="${TSAN_OPTIONS:-halt_on_error=1:second_deadlock_stack=1}" \
            run_tests "$tsan_dir" "$@"
        ;;
    fuzz)
        fuzz_dir="$build_root/fuzz"
        fuzz_target="${1:-all}"
        fuzz_seconds="${2:-60}"
        if [[ ! "$fuzz_seconds" =~ ^[1-9][0-9]*$ ]]; then
            echo "fuzz seconds must be a positive integer" >&2
            exit 2
        fi
        configure "$fuzz_dir" \
            -DCMAKE_C_COMPILER="${FUZZ_CC:-clang}" \
            -DCMAKE_CXX_COMPILER="${FUZZ_CXX:-clang++}" \
            -DBALE_LINK_COMPILE_COMMANDS=OFF \
            -DBALE_BUILD_TESTS=OFF \
            -DBALE_BUILD_FUZZERS=ON \
            -DCMAKE_BUILD_TYPE=RelWithDebInfo
        targets=()
        if [[ "$fuzz_target" == all ]]; then
            for seeds in "$repo_root"/tests/fuzz/corpus/*/; do
                targets+=("$(basename "$seeds")")
            done
        else
            targets=("$fuzz_target")
        fi
        build "$fuzz_dir" --target "${targets[@]}"
        for target in "${targets[@]}"; do
            seeds="$repo_root/tests/fuzz/corpus/$target"
            corpus="$fuzz_dir/corpus/$target"
            artifacts="$fuzz_dir/artifacts/$target"
            mkdir -p "$corpus" "$artifacts"
            dictionary=()
            if [[ -f "$repo_root/tests/fuzz/$target.dict" ]]; then
                dictionary=("-dict=$repo_root/tests/fuzz/$target.dict")
            fi
            echo "fuzzing $target for ${fuzz_seconds}s"
            ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=1}" \
                UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1:halt_on_error=1}" \
                "$fuzz_dir/tests/fuzz/$target" \
                -max_total_time="$fuzz_seconds" \
                -timeout=10 \
                -rss_limit_mb=2048 \
                -print_final_stats=1 \
                -artifact_prefix="$artifacts/" \
                "${dictionary[@]}" \
                "$corpus" "$seeds"
        done
        ;;
    cover)
        cover_dir="$build_root/cover"
        configure "$cover_dir" \
            -DBALE_LINK_COMPILE_COMMANDS=OFF \
            -DCMAKE_BUILD_TYPE=Debug \
            -DCMAKE_C_FLAGS="--coverage" \
            -DCMAKE_CXX_FLAGS="--coverage" \
            -DCMAKE_EXE_LINKER_FLAGS="--coverage" \
            -DCMAKE_SHARED_LINKER_FLAGS="--coverage"
        find "$cover_dir" -name '*.gcda' -delete
        build "$cover_dir"
        run_tests "$cover_dir" "$@"
        if command -v gcovr >/dev/null; then
            gcovr --root "$repo_root" \
                --filter "$repo_root/src/" \
                --filter "$repo_root/include/" \
                --print-summary \
                "$cover_dir"
        else
            echo "gcovr not found; raw coverage data is in $cover_dir" >&2
        fi
        ;;
    windows)
        windows_dir="$build_root/windows"
        configure "$windows_dir" \
            -DBALE_LINK_COMPILE_COMMANDS=OFF \
            -DCMAKE_BUILD_TYPE=Debug \
            -DCMAKE_TOOLCHAIN_FILE="$repo_root/cmake/toolchains/mingw-w64-x86_64.cmake"
        build "$windows_dir"
        WINEDEBUG="${WINEDEBUG:--all}" run_tests "$windows_dir" "$@"
        ;;
    run)
        target="${1:-bale}"
        if (($#)); then
            shift
        fi
        configure "$build_dir"
        build "$build_dir" --target "$target"
        executable="$(
            find "$build_dir" -path '*/CMakeFiles' -prune -o \
                -type f -name "$target" -perm -u+x -print \
                | head -n 1
        )"
        if [[ -z "$executable" ]]; then
            echo "no executable named $target in $build_dir" >&2
            exit 1
        fi
        exec "$executable" "$@"
        ;;
    format)
        "$repo_root/fmt"
        ;;
    format-check)
        "$repo_root/fmt" --check
        ;;
    lint)
        lint
        ;;
    check)
        "$repo_root/fmt" --check
        lint
        run_tests "$build_dir"
        ;;
    lines)
        git -C "$repo_root" ls-files -z --cached --others --exclude-standard --deduplicate \
            | (cd "$repo_root" && xargs -0 -r wc -l) \
            | sort -n
        ;;
    clean)
        rm -rf "$build_root"
        ;;
    *)
        cat <<USAGE
usage: ./dev <command> [args...]

  setup         list required tools
  configure     configure the dev build (extra args go to cmake)
  build         build the dev build (extra args go to cmake --build)
  test          build and run ctest (extra args go to ctest)
  sanitize      build and test with ASan and UBSan in build/sanitize
  tsan          build and test with ThreadSanitizer in build/tsan
  fuzz [target] [seconds]
                build the libFuzzer targets with Clang in build/fuzz and run each one (or
                one) for N seconds (default 60) from its seed corpus; crashes land in
                build/fuzz/artifacts
  cover         build and test with coverage in build/cover, summary via gcovr
  windows       cross-build with MinGW in build/windows and run the tests under Wine
  run [target]  build and run an executable target (default: bale)
  format        format C and C++ sources in place
  format-check  fail if any source needs formatting
  lint          run clang-tidy over project sources
  check         format-check, lint and test
  lines         line counts of tracked and untracked files
  clean         remove build/

Environment: BUILD_DIR overrides build/dev, JOBS sets parallelism.
USAGE
        if [[ "$cmd" != help ]]; then
            exit 2
        fi
        ;;
esac
